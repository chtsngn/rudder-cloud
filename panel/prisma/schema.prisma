generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SiteType {
  WORDPRESS
  PHP
  NODEJS
  STATIC
  PYTHON
  REVERSE_PROXY
  DOCKER
}

enum SiteStatus {
  ACTIVE
  PROVISIONING
  STOPPED
  FAILED
}

// Bir sitenin uygulama sürecini kim ayakta tutuyor. SYSTEMD (varsayılan):
// panelin kendi provision-site.sh'ının oluşturduğu systemd birimi. Diğerleri:
// kullanıcı süreci kendi seçtiği araçla yönetiyor, panel yalnızca restart
// tetikler/proxy eder — bkz. docs/ARCHITECTURE.md → Aşama B.
enum ProcessManager {
  SYSTEMD
  DOCKER_COMPOSE
  PM2
  CUSTOM_SCRIPT
}

// Kullanıcı/rol/izin yönetimi (Aşama G). SUPER_ADMIN her şeye erişir (bkz.
// src/lib/permissions.ts → isSuperAdmin). MEMBER yalnızca kendisine
// `UserSiteAccess` ile açıkça verilmiş sitelere, verilmiş izinler ölçüsünde
// erişir.
enum UserRole {
  SUPER_ADMIN
  MEMBER
}

// `src/lib/permissions.ts`'teki hand-rolled `SitePermission` union'ıyla
// BİREBİR aynı 6 değer — orada TS tarafında string literal olarak kalıyor
// (Prisma enum'ı client component'lara sızmasın diye, bkz. site-adapter.ts
// deseni), burada DB tarafında gerçek bir enum olarak saklanıyor
// (`UserSiteAccess.permissions`).
enum SitePermission {
  VIEW
  EDIT_FILES
  RESTART
  DELETE
  MANAGE_BACKUPS
  MANAGE_DEPLOY_KEYS
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         UserRole @default(SUPER_ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Aşama G — bir MEMBER'a hangi sitelerde hangi izinler verildiği
  // (SUPER_ADMIN için bu tablo hiç kullanılmaz, her zaman tam erişim vardır).
  siteAccess UserSiteAccess[]
  // Kullanıcı silinse bile denetim kaydı KALIR (bkz. AuditLog.userId
  // onDelete: SetNull + denormalize edilmiş `username` alanı).
  auditLogs  AuditLog[]
}

model Site {
  id         String     @id @default(cuid())
  domain     String     @unique
  type       SiteType
  status     SiteStatus @default(PROVISIONING)
  // `sslEnabled`: kullanıcının bu site için SSL İSTEDİĞİ (site oluşturma
  // sihirbazındaki anahtar) — gerçekleşip gerçekleşmediğini YANSITMAZ.
  // Gerçek sonuç `sslStatus`/`sslLastError`'da: SSL isteği (certbot) DNS
  // henüz yönlendirilmemiş gibi nedenlerle başarısız olsa bile site
  // provisioning'i (vhost/systemd/db) BAŞARILI kabul edilir ve site ACTIVE
  // kalır — SSL ayrı, tekrar denenebilir bir alt durum (bkz.
  // /api/sites/[id]/ssl route.ts). sslStatus: none | active | error.
  sslEnabled    Boolean @default(false)
  sslStatus     String  @default("none")
  sslLastError  String?
  config     Json
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  // Git dağıtımı (Aşama B) — hepsi opsiyonel, mevcut sitelerin çoğunda boş kalır.
  repoUrl                 String?
  gitBranch               String          @default("main")
  autoPullEnabled         Boolean         @default(false)
  autoPullIntervalSeconds Int             @default(15)
  lastPullAt              DateTime?
  lastPullOk              Boolean?
  lastPullError           String?

  // Proje restart (Aşama B) — yalnızca NODEJS/PYTHON/REVERSE_PROXY için anlamlı.
  processManager       ProcessManager @default(SYSTEMD)
  customRestartCommand String?

  // Veritabanı yedekleme (Aşama D) — bkz. docs/ARCHITECTURE.md → Aşama D.
  // Her sitenin TEK bir zamanlaması var (BackupSchedule gibi ayrı bir tablo
  // yerine — Aşama B'deki autoPull* alanlarıyla aynı, kanıtlanmış desen).
  backupEnabled         Boolean   @default(false)
  backupIntervalSeconds Int       @default(86400)
  backupRetentionCount  Int       @default(7)
  backupUploadToS3      Boolean   @default(false)
  s3ConfigId            String?
  s3Config              S3Config? @relation(fields: [s3ConfigId], references: [id], onDelete: SetNull)
  lastBackupAt          DateTime?
  lastBackupOk          Boolean?
  lastBackupError       String?

  // GitHub deploy key / Actions key (Aşama E) — private key ASLA veritabanına
  // yazılmaz, yalnızca `panel` kullanıcısının kendi ~/.ssh dizininde (0600)
  // durur (bkz. src/lib/github-keys.ts). Buradaki alanlar yalnızca PUBLIC
  // bilgiyi önbelleğe alır (arayüzde göstermek için disk her istekte
  // okunmasın diye).
  deployKeyName         String?
  deployKeyPublicKey    String?
  deployKeyFingerprint  String?
  deployKeyCreatedAt    DateTime?

  actionsKeyName         String?
  actionsKeyPublicKey    String?
  actionsKeyFingerprint  String?
  actionsKeyCreatedAt    DateTime?

  // GitHub App entegrasyonu (Aşama H — PAT tabanlı "tüm depolara erişim"
  // modelinin yerini alır, bkz. GitHubAppConfig/GitHubInstallation notu).
  // Bir site GERÇEK bir App kurulumundaki (installation) belirli bir depoya
  // bağlanabilir; bağlandığında git clone/pull SSH deploy key YERİNE bu
  // kurulumun kısa ömürlü "installation token"ıyla HTTPS üzerinden yapılır
  // (bkz. src/lib/github-app.ts, src/lib/git.ts). NULL ise site eskisi gibi
  // elle girilen `repoUrl` (SSH/HTTPS) ile çalışmaya devam eder.
  githubInstallationId String?
  githubInstallation   GitHubInstallation? @relation(fields: [githubInstallationId], references: [id], onDelete: SetNull)
  githubRepoFullName   String? // "owner/repo" — installation token'ın hangi depoya ait olduğunu bilmek için

  // Kullanıcı/rol/izin yönetimi (Aşama G) — bu siteye erişimi olan MEMBER'lar.
  userAccess UserSiteAccess[]
}

// AWS S3 (ya da S3-uyumlu — MinIO, DigitalOcean Spaces vb.) bağlantı bilgileri.
// `secretAccessKeyEnc` düz metin DEĞİL — AES-256-GCM ile `SETTINGS_ENCRYPTION_KEY`
// kullanılarak şifrelenmiş saklanır (bkz. src/lib/crypto.ts). Panel genelinde
// birden fazla config tanımlanabilir (örn. farklı bölgeler/hesaplar için).
model S3Config {
  id                 String   @id @default(cuid())
  label              String   @default("Varsayılan")
  bucket             String
  region             String
  endpoint           String?
  accessKeyId        String
  secretAccessKeyEnc String
  pathPrefix         String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sites Site[]
}

// Bir MEMBER kullanıcısının BELİRLİ bir sitede sahip olduğu izinler.
// SUPER_ADMIN için satır oluşturulmaz (gerek yok, her zaman tam erişimi var
// — bkz. src/lib/permissions.ts → canManageSite). Kullanıcı veya site
// silinince bu satır da otomatik silinir (her iki taraf da cascade).
model UserSiteAccess {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteId      String
  site        Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  permissions SitePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([userId, siteId])
}

// Hafif, salt-okunur denetim kaydı (bkz. docs/ARCHITECTURE.md → Aşama G).
// `username` KASITLI denormalize edildi: kullanıcı daha sonra silinse bile
// (userId → SetNull) geçmiş kayıtlar "kim yaptı" bilgisini kaybetmesin diye.
// Ağır bir filtreleme/sayfalama şeması bilinçli olarak kapsam dışı
// bırakıldı (basit, kronolojik bir liste yeterli görüldü).
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  username   String
  action     String
  targetType String?
  targetId   String?
  detail     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

// Panelin kendi alan adını (opsiyonel) ve gerçek Let's Encrypt SSL sertifikası
// bağlama durumunu tutan TEK satırlık singleton — `id` her zaman sabit
// "panel" değeridir (bkz. src/app/api/settings/domain/route.ts). `domain` null ise panel
// yalnızca IP:port (varsayılan :24428, bkz. install.sh) üzerinden erişilir;
// bu durum HİÇBİR ZAMAN devre dışı bırakılmaz — alan adı bağlansa bile
// :24428 her zaman yedek erişim yolu olarak çalışmaya devam eder (bkz.
// scripts/provision-site.sh → configure-panel-domain notu, panel.conf'a hiç
// dokunulmaz). `sslStatus`: none | pending | active | error.
// `terminalIdleTimeoutSeconds`: web terminalinde kullanıcı girdisi olmadan
// geçebilecek azami süre (bkz. server.mjs → enforceIdleTimeout). NULL/0 =
// SINIRSIZ (varsayılan) — terminal hiçbir zaman kendiliğinden kapanmaz. Bu,
// Nginx'in websocket tüneli için varsayılan ~60sn'lik boşta-kalma zaman
// aşımından TAMAMEN AYRI bir kavram: o sorun server.mjs'teki ping/pong
// heartbeat ile (her zaman aktif) çözülüyor; buradaki alan yalnızca isteğe
// bağlı, kullanıcı girdisine dayalı bir GÜVENLİK önlemi (ör. denetimsiz
// bırakılan bir root kabuğunu otomatik kapatmak).
model PanelSettings {
  id                          String   @id @default("panel")
  domain                      String?
  domainEmail                 String?
  sslEnabled                  Boolean  @default(false)
  sslStatus                   String   @default("none")
  lastError                   String?
  terminalIdleTimeoutSeconds  Int?
  updatedAt                   DateTime @updatedAt
}

// GitHub App Entegrasyonu (Aşama H, PAT akışının yerini alır)
//
// Eskiden ("Aşama E") kullanıcı bir Personal Access Token yapıştırıyordu —
// bu token'ın kapsamı ne ise (genelde tüm repo'lar) panel de onu görüyordu.
// Artık gerçek bir GitHub App: panel GitHub'ın "manifest flow"uyla
// (bkz. src/lib/github-app.ts, https://docs.github.com/apps/creating-github-apps/registering-a-github-app/creating-a-github-app-from-a-manifest)
// kendi App'ini OTOMATİK oluşturur — App ID/private key elle kopyalanmaz,
// GitHub bunları `POST /app-manifests/{code}/conversions` ile tek seferde
// döner. Panel genelinde TEK bir App kimliği vardır (S3Config/PanelSettings
// gibi panel-wide, tek bir dashboard kullanıcısına özel DEĞİL) — `id` her
// zaman sabit "panel". Sırlar (`clientSecretEnc`/`webhookSecretEnc`/
// `privateKeyEnc`) AES-256-GCM ile şifreli (crypto.ts), istemciye ASLA
// döndürülmez.
model GitHubAppConfig {
  id               String   @id @default("panel")
  appId            String
  slug             String
  name             String
  clientId         String
  clientSecretEnc  String
  webhookSecretEnc String
  privateKeyEnc    String
  htmlUrl          String
  ownerLogin       String
  ownerAvatarUrl   String?
  createdByUserId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  installations GitHubInstallation[]
}

// Bir "kurulum" (installation) = App'in belirli bir GitHub kullanıcı/
// organizasyon hesabına, GitHub'ın KENDİ ekranından seçilen depolarla (veya
// "tüm depolar" ile) kurulması — "kullanıcının izin verdiği repolar" tam
// olarak burada GitHub tarafından uygulanıyor. Panel kendi tarafında ayrıca
// bir izin listesi TUTMAZ; hangi depolara erişebileceğini her seferinde
// `GET /installation/repositories` ile TAZE sorgular (bkz. github-app.ts) —
// kullanıcı GitHub'da izinleri değiştirdiğinde (repo ekle/çıkar, App'i
// kaldır) panel de bir sonraki istekte anında yansıtır, ayrı bir senkron
// mekanizması gerekmez.
model GitHubInstallation {
  id                  String          @id @default(cuid())
  installationId      String          @unique
  appConfigId         String          @default("panel")
  appConfig           GitHubAppConfig @relation(fields: [appConfigId], references: [id], onDelete: Cascade)
  accountLogin        String
  accountAvatarUrl    String?
  accountType         String // "User" | "Organization"
  repositorySelection String // "all" | "selected"
  installedByUserId   String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  sites Site[]
}

