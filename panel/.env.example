# Postgres connection string used by Prisma.
DATABASE_URL=postgresql://user:password@localhost:5432/panel_db

# Secret used to sign session JWTs. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# Used to encrypt S3 backup credentials at rest (AES-256-GCM). Generate one with:
#   openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=

# --- Set by install.sh on a server (kept outside the rsync'd PANEL_DIR) ---
# Per-site SSH deploy keys (unset: ~/.ssh).
# DEPLOY_KEYS_DIR=/var/lib/rudder/ssh
# Local database backups and pre-deploy dumps (dir 0700, files 0600).
# BACKUP_DIR=/var/lib/rudder/backups
# Docker CLI config of the panel user (buildx builder choice, registry logins);
# inherited by deploy commands and compose actions.
# DOCKER_CONFIG=/var/lib/rudder/docker
# Address the nginx vhost for the panel listens on: empty = all interfaces,
# 127.0.0.1 = loopback only (reach it through an SSH tunnel or a proxy).
# PANEL_PUBLIC_HOST=
